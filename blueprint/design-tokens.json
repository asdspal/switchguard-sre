    },
    "semantic": {
      "success": { "value": "#34D399", "rationale": "Healthy v2.13.2 & FlashProve VERIFIED state (9.68:1)" },
      "warning": { "value": "#FBBF24", "rationale": "PENDING_APPROVAL human gate banner (11.66:1)" },
      "error": { "value": "#F87171", "rationale": "HTTP 500 v2.14.0 outage & tampered proof alert (6.81:1)" },
      "info": { "value": "#38BDF8", "rationale": "Room link routing indicator" }
